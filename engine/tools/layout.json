{
  "version": "4.0",
  "updated": "2026-11-17",
  "comment": "仓库目录结构单一事实源（tech-context-digest 三层架构：content/ 内容层、engine/ 引擎层、data/ 资产层）。六主题：economy / tech / education / international / political / society。含 region 维度的主题 region 先于 category（economy）；tech 及后续主题按 category→region。业务线默认位于 content/<theme>/<维度段...>/，以 prompts/business-config.md 为锚点。",
  "root_reserved": [
    "content",
    "engine",
    "data",
    ".github",
    ".gitignore",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "requirements.txt",
    "index.html",
    "reader.html",
    "INDEX.md",
    "automation-status.json",
    "perf-status.json"
  ],
  "content_root": "content",
  "regional_segment": "",
  "themes": {
    "economy": { "name": "经济", "dimensions": ["region", "category"] },
    "tech": { "name": "科技", "dimensions": ["category", "region"] },
    "education": { "name": "教育", "dimensions": ["category", "region"] },
    "international": { "name": "国际", "dimensions": ["category", "region"] },
    "political": { "name": "政治", "dimensions": ["category", "region"] },
    "society": { "name": "社会", "dimensions": ["category", "region"] }
  },
  "regions": ["dubai", "global"],
  "naming": {
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "max_depth": 6
  }
}
