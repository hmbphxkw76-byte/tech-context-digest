    <tr><td>K08</td><td>成交量同比</td><td>−38%（2026Q3）</td><td><span class="pill p">预警红</span></td><td>1 期</td><td>超 8pp</td><td>连续 2 季 &lt;−30%</td><td>正常</td><td>维持</td></tr>
    <tr><td>K09</td><td>现房成交金额占比</td><td>现房 +18.5% QoQ</td><td><span class="pill g">绿灯</span></td><td>1 期</td><td>未触发</td><td>单季下滑</td><td>正常</td><td>维持；按金额复核</td></tr>
