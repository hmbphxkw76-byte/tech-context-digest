      grid:{left:62,right:24,top:74,bottom:42},
      xAxis:{type:'category',data:['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11-06','11-09','11-10','11-11','11-12'],axisLine:{lineStyle:{color:palette.line}},axisTick:{show:false},axisLabel:{color:palette.ink2,fontSize:11}},
      yAxis:{type:'value',min:3.4,max:4.7,axisLine:{show:false},axisTick:{show:false},axisLabel:{color:palette.ink2,fontSize:11,formatter:'{value}%'},splitLine:{lineStyle:{color:'#eef2f6'}}},
      series:[
        {name:'月均（1–10 月）',type:'line',smooth:false,symbol:'circle',symbolSize:6,data:[3.578997,3.572268,3.637528,3.750042,3.750571,3.804954,3.870124,3.899114,4.177326,4.303021,null,null,null,null,null],lineStyle:{color:palette.blue,width:2},itemStyle:{color:palette.blue},connectNulls:false},
        {name:'11 月逐日定盘',type:'line',smooth:false,symbol:'circle',symbolSize:7,data:[null,null,null,null,null,null,null,null,null,null,4.206770,4.321380,4.364820,4.339930,4.394390],lineStyle:{color:palette.navy,width:2.4},itemStyle:{color:palette.navy},connectNulls:false,
          label:{show:true,position:'top',color:palette.navy,fontSize:11,formatter:function(p){return p.value==null?'':p.value.toFixed(5);}},
          markLine:{silent:true,symbol:'none',data:[
            {yAxis:4.50,lineStyle:{color:palette.red,type:'solid',width:1.6},label:{formatter:'硬红线 4.50%',color:palette.red,fontSize:10,position:'insideEndTop'}},
            {yAxis:4.35,lineStyle:{color:palette.pre,type:'dashed',width:1.3},label:{formatter:'预警红线 4.35%（已越 4.44bp）',color:palette.pre,fontSize:10,position:'insideEndBottom'}},
            {yAxis:3.50,lineStyle:{color:palette.green,type:'dashed',width:1.2},label:{formatter:'绿灯 3.50%',color:palette.green,fontSize:10,position:'insideEndBottom'}}
          ]}
        }
      ]
    });
    window.addEventListener('resize',function(){c1.resize();});
  }

  var dom2=document.getElementById('chartRate');
  if(dom2){
    var c2=echarts.init(dom2,null,{renderer:'canvas'});
    c2.setOption({
      backgroundColor:'#ffffff',
      title:{text:'利率敏感性：月供与可负担房价',subtext:'假设 AED 2,000,000 / 300 个月 / 等额本息 / 利率全额传导｜假设性测算，非机构发布',left:8,top:4,textStyle:{fontSize:14,color:palette.navy,fontWeight:'bold'},subtextStyle:{fontSize:11,color:palette.ink2}},
      tooltip:{trigger:'axis',axisPointer:{type:'shadow'},formatter:function(params){var s=params[0].axisValue+'<br/>';for(var i=0;i<params.length;i++){var p=params[i];s+=p.marker+(p.seriesName==='月供'?'月供：AED '+Number(p.value).toLocaleString()+'/月':'可负担房价：'+p.value+'%')+'<br/>';}return s;}},
      legend:{top:30,right:12,itemWidth:12,itemHeight:8,textStyle:{color:palette.ink2,fontSize:11}},
      grid:{left:68,right:64,top:78,bottom:44},
      xAxis:{type:'category',data:['4.3944%（当前）','4.50%（红线）','4.75%','5.00%','5.25%'],axisLine:{lineStyle:{color:palette.line}},axisTick:{show:false},axisLabel:{color:palette.ink2,fontSize:11}},
      yAxis:[
        {type:'value',name:'月供 AED',min:10400,max:12200,nameTextStyle:{color:palette.ink2,fontSize:11},axisLine:{show:false},axisTick:{show:false},axisLabel:{color:palette.ink2,fontSize:11,formatter:function(v){return (v/1000)+'k';}},splitLine:{lineStyle:{color:'#eef2f6'}}},
        {type:'value',name:'可负担房价变化 %',min:-9,max:1,nameTextStyle:{color:palette.red,fontSize:11},axisLine:{show:false},axisTick:{show:false},axisLabel:{color:palette.red,fontSize:11,formatter:'{value}%'},splitLine:{show:false}}
      ],
      series:[
        {name:'月供',type:'bar',barWidth:34,data:[10997,11117,11402,11692,11985],itemStyle:{color:palette.navy}},
        {name:'可负担房价',type:'line',yAxisIndex:1,symbol:'circle',symbolSize:7,data:[0,-1.08,-3.55,-5.94,-8.24],lineStyle:{color:palette.red,width:2},itemStyle:{color:palette.red}}
      ]
    });
    window.addEventListener('resize',function(){c2.resize();});
  }

  var dom3=document.getElementById('chartPrice');
  if(dom3){
    var c3=echarts.init(dom3,null,{renderer:'canvas'});
    c3.setOption({
      backgroundColor:'#ffffff',
      title:{text:'价格口径对照（不可直接相减）',subtext:'单位 AED/sqft｜统计域与调整方法各异｜价格页 11-12 更新；PIX 页 10 月发布',left:8,top:4,textStyle:{fontSize:14,color:palette.navy,fontWeight:'bold'},subtextStyle:{fontSize:11,color:palette.ink2}},
      grid:{left:208,right:68,top:64,bottom:34},
      tooltip:{trigger:'axis',axisPointer:{type:'shadow'}},
      xAxis:{type:'value',axisLine:{show:false},axisTick:{show:false},axisLabel:{color:palette.ink2,fontSize:11},splitLine:{lineStyle:{color:'#eef2f6'}}},
      yAxis:{type:'category',inverse:true,data:['公寓登记中位（2026-10）','全住宅中位·价格页（11-12 更新）','全住宅中位·PIX 页（10 月发布）','城市指数（2026-09）','公寓成交均价（2026Q3）','顶级公寓均价（2026Q3）'],axisLine:{lineStyle:{color:palette.line}},axisTick:{show:false},axisLabel:{color:palette.ink2,fontSize:11.5}},
      series:[{type:'bar',barWidth:15,data:[{value:1659,itemStyle:{color:palette.navy}},{value:1639,itemStyle:{color:palette.blue}},{value:1637,itemStyle:{color:palette.light}},{value:1644,itemStyle:{color:'#7fa4cd'}},{value:1817,itemStyle:{color:'#c08a3e'}},{value:5237,itemStyle:{color:palette.red}}],label:{show:true,position:'right',color:palette.ink,fontSize:11,formatter:'{c}'}}]
    });
    window.addEventListener('resize',function(){c3.resize();});
  }

  var dom4=document.getElementById('chartRent');
  if(dom4){
    var c4=echarts.init(dom4,null,{renderer:'canvas'});
    c4.setOption({
      backgroundColor:'#ffffff',
      title:{text:'公寓新签租约中位租金（按面积段）',subtext:'单位 AED/年｜Ejari 登记｜Peak Trust 2026-10（发布 2026-11-03，本期复核确认）',left:8,top:4,textStyle:{fontSize:14,color:palette.navy,fontWeight:'bold'},subtextStyle:{fontSize:11,color:palette.ink2}},
      tooltip:{trigger:'axis',axisPointer:{type:'shadow'}},
      legend:{top:30,right:12,itemWidth:12,itemHeight:8,textStyle:{color:palette.ink2,fontSize:11}},
      grid:{left:72,right:24,top:76,bottom:42},
      xAxis:{type:'category',data:['<550 sqft','550–850','850–1,300','>1,300','全部公寓'],axisLine:{lineStyle:{color:palette.line}},axisTick:{show:false},axisLabel:{color:palette.ink2,fontSize:11}},
      yAxis:{type:'value',name:'AED/年',nameTextStyle:{color:palette.ink2,fontSize:11},axisLine:{show:false},axisTick:{show:false},axisLabel:{color:palette.ink2,fontSize:11,formatter:function(v){return v/1000+'k';}},splitLine:{lineStyle:{color:'#eef2f6'}}},
      series:[
        {name:'7 月',type:'bar',data:[40000,55800,69300,100000,62000],itemStyle:{color:'#c9d7e8'},barGap:'10%'},
        {name:'8 月',type:'bar',data:[42000,60500,75000,115000,67000],itemStyle:{color:'#9db9da'}},
        {name:'9 月',type:'bar',data:[43000,63000,78175,115000,68000],itemStyle:{color:'#5f88bb'}},
        {name:'10 月',type:'bar',data:[44000,62000,77175,120000,65000],itemStyle:{color:palette.navy}}
      ]
    });
    window.addEventListener('resize',function(){c4.resize();});
  }
})();
</script>

<script>
(function(){
  var nav=document.querySelector('.report-nav');
  if(!nav)return;
  var tabs=Array.prototype.slice.call(nav.querySelectorAll('.nav-tabs a'));
  var targets=tabs.map(function(a){
    var id=a.getAttribute('href');
    return id&&id.charAt(0)==='#'?document.getElementById(id.slice(1)):null;
  });
  var headings=document.querySelectorAll('h2.sec,h3[id],#main-content');
  function updateOffsets(){
    var h=nav.offsetHeight+12;
    Array.prototype.forEach.call(headings,function(el){el.style.scrollMarginTop=h+'px';});
  }
  function updateActive(){
    var pos=window.scrollY+nav.offsetHeight+24;
    var cur=0;
    for(var i=0;i<targets.length;i++){
      var el=targets[i];
      if(!el)continue;
      var top=el.getBoundingClientRect().top+window.scrollY;
      if(top<=pos)cur=i;else break;
    }
    if(window.innerHeight+window.scrollY>=document.documentElement.scrollHeight-2)cur=tabs.length-1;
    tabs.forEach(function(a,i){a.classList.toggle('active',i===cur);});
  }
  updateOffsets();
  updateActive();
  window.addEventListener('resize',function(){updateOffsets();updateActive();},{passive:true});
  window.addEventListener('scroll',updateActive,{passive:true});
})();
</script>
</body>
</html>
