    <tr><td>K03</td><td>许可建筑面积同比</td><td>+48%（2026Q1）</td><td><span class="pill p">预警红</span></td><td>1 期</td><td>超 18pp（仅 1 季）</td><td>第 2 季 &gt;30% 升级硬红</td><td>停更（Q2/Q3 无同类发布）</td><td>维持</td></tr>
    <tr><td>K04</td><td>交付兑现率</td><td>41.3%（2026H1）</td><td><span class="pill r">硬红·方向</span></td><td>1 期</td><td>低于 3.7pp</td><td>双源同口径互证</td><td>部分核验</td><td>维持；补同口径双源</td></tr>
